{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holokai.org/schemas/world-observation.schema.json",
  "title": "HoloKai World Observation",
  "type": "object",
  "required": ["schemaVersion", "observedAt", "source", "frame", "robot", "entities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "frame": { "type": "string", "minLength": 1 },
    "robot": { "type": "object" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityId"],
        "properties": {
          "entityId": { "type": "string", "minLength": 1 },
          "semanticType": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "position": { "type": "object" },
          "orientation": { "type": "object" },
          "lastObservedAt": { "type": "string", "format": "date-time" },
          "provenance": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "entityCount": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
