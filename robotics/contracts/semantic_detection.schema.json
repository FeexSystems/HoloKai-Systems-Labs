{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holokai.org/schemas/semantic-detection.v1.json",
  "title": "HoloKai Semantic Detection",
  "type": "object",
  "required": ["detections"],
  "properties": {
    "frame": {"type": "string", "default": "map"},
    "detectorSource": {"type": "string"},
    "robot": {"type": "object"},
    "sensorMetadata": {"type": "object"},
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence"],
        "properties": {
          "entityId": {"type": "string"},
          "label": {"type": "string", "minLength": 1},
          "semanticType": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "trackId": {"type": ["string", "integer"]},
          "pose": {"type": "object"},
          "bbox": {"type": "object"},
          "epistemicStance": {
            "type": "string",
            "enum": ["ESTABLISHED", "SCHOLARLY_DEBATE", "TRADITION", "ESOTERIC", "SPECULATIVE", "FICTIONAL"]
          },
          "provenance": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
