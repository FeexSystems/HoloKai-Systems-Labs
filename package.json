{
  "name": "holokai-civilization-core",
  "private": true,
  "description": "HoloKai monorepo. Active frontend: holo-kai/. Orbital lab entry: HoloKai - landingpage/.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "edge/*",
    "holo-kai",
    "HoloKai - landingpage"
  ],
  "scripts": {
    "dev": "npm --prefix holo-kai run dev",
    "dev:bff": "pnpm --filter @holokai/bff dev",
    "dev:all": "turbo dev",
    "dev:app": "npm --prefix holo-kai run dev",
    "dev:landingpage": "npm --prefix \"HoloKai - landingpage\" run dev",
    "build": "npm --prefix holo-kai run build",
    "build:landingpage": "npm --prefix \"HoloKai - landingpage\" run build",
    "deploy:hosting": "npm --prefix holo-kai run build && firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:firebase": "npm --prefix holo-kai run build && firebase deploy",
    "lint": "npm --prefix holo-kai run lint",
    "preview": "npm --prefix holo-kai run preview"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.28.0",
    "@google/genai": "^2.13.0",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.21",
    "@types/pg": "^8.20.3",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "genkit": "^1.40.1",
    "leaflet": "^1.9.4",
    "pg": "^8.22.0"
  }
}
