# HoloKai BFF Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/holokai

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_example_secret

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Python Engine (Alive API)
PYTHON_ENGINE_URL=http://localhost:8001

# Physical AI / NVIDIA Isaac
# Keep empty on web-only deployments. Set only on a BFF host that can reach the robotics gateway.
HOLOKAI_ROBOTICS_MODE=disabled
HOLOKAI_ROBOTICS_GATEWAY_URL=http://robotics-gateway:8080
